{
  "name": "anbar-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply anbar-db --local",
    "db:remote": "wrangler d1 migrations apply anbar-db --remote",
    "admin": "node scripts/create-admin.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/browser-test.js",
    "format": "prettier --write client/src server scripts tests vite.config.js wrangler.jsonc package.json"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.2.0",
    "@fontsource/noto-sans-arabic": "^5.2.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "miniflare": "^5.20261113.0-beta",
    "prettier": "^3.10.1",
    "vite": "^7.1.0",
    "wrangler": "^4.44.0"
  }
}
